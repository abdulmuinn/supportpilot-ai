# API
SUPPORTPILOT_API_HOST=0.0.0.0
SUPPORTPILOT_API_PORT=8000

# Streamlit -> FastAPI
SUPPORTPILOT_API_URL=http://127.0.0.1:8000

# Model
SUPPORTPILOT_MODEL_ID=
SUPPORTPILOT_MODEL_REVISION=

# inference
SUPPORTPILOT_MAX_LENGTH=64

# Inference policy
SUPPORTPILOT_MIN_CONFIDENCE=0.70
SUPPORTPILOT_MIN_MARGIN=0.10
SUPPORTPILOT_FALLBACK_INTENT=fallback

# Logging
SUPPORTPILOT_LOG_LEVEL=INFO

# Docker Compose local model mount
SUPPORTPILOT_MODEL_HOST_PATH=/absolute/path/to/model
