FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

RUN groupadd --system appgroup \
    && useradd \
        --system \
        --gid appgroup \
        --create-home \
        appuser

COPY src/supportpilot/__init__.py ./src/supportpilot/__init__.py
COPY src/supportpilot/config.py ./src/supportpilot/config.py
COPY src/supportpilot/ui ./src/supportpilot/ui
COPY dashboard ./dashboard

RUN python -m pip install --upgrade pip \
    && python -m pip install \
        "httpx>=0.28,<0.29" \
        "streamlit>=1.61,<1.62" \
        "pandas>=3.0,<3.1" \
        "altair>=6.2,<6.3"

USER appuser

EXPOSE 8501

HEALTHCHECK \
    --interval=15s \
    --timeout=5s \
    --start-period=20s \
    --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4)"]

CMD ["python", "-m", "streamlit", "run", "dashboard/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
